PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/acme_compensation_hub?schema=public"

# Session / cookies (required for auth)
SESSION_SECRET="replace-with-a-long-random-secret"
# Absolute/idle-style cookie max-age in seconds (default 8 hours)
SESSION_TTL=28800
# Local/dev: false. Production always requires Secure cookies (COOKIE_SECURE=false is rejected).
COOKIE_SECURE=false
# Exact browser origins allowed for state-changing requests (comma-separated).
# Local: include every Next origin you use (Next may bind :3001 if :3000 is taken).
# Production demo: set ONLY the Vercel deployment origin, e.g. https://your-app.vercel.app
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Optional login rate limit (in-memory, per API process)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Local development seed only (never use in production) ---
# The seed script refuses to run when NODE_ENV=production.
SEED_HR_EMAIL="hr.demo@acme.local"
SEED_HR_PASSWORD="change-me-local-only"
SEED_HR_DISPLAY_NAME="Demo HR Manager"

# Destructive reseed (development/test only). Requires SEED_RESET=true and NODE_ENV!=production.
# SEED_RESET=true

# --- Production one-time HR bootstrap (operator machine / shell; never commit values) ---
# BOOTSTRAP_HR_EMAIL="hr@example.com"
# BOOTSTRAP_HR_PASSWORD="use-a-long-unique-password"
# BOOTSTRAP_HR_DISPLAY_NAME="HR Manager"
