// ACME Compensation Hub — PostgreSQL schema
// Source of truth: docs/DATABASE_SCHEMA.md
// Business models only; no seed or application logic here.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext]
}

model Department {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@map("departments")
}

model Country {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.Char(2)
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employees Employee[]

  @@map("countries")
}

model Employee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeNumber String    @unique @map("employee_number")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  jobTitle       String    @map("job_title")
  departmentId   String    @map("department_id") @db.Uuid
  countryId      String    @map("country_id") @db.Uuid
  status         String    @default("ACTIVE")
  hireDate       DateTime? @map("hire_date") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  salary     Salary?

  @@index([lastName, firstName], map: "employees_last_name_first_name_idx")
  @@index([countryId], map: "employees_country_id_idx")
  @@index([departmentId], map: "employees_department_id_idx")
  @@index([jobTitle], map: "employees_job_title_idx")
  @@index([status], map: "employees_status_idx")
  @@map("employees")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  salaryRevisions SalaryRevision[]

  @@map("users")
}

model Salary {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @unique @map("employee_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @db.Char(3)
  effectiveDate DateTime @map("effective_date") @db.Date
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  employee  Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions SalaryRevision[]

  @@map("salaries")
}

model SalaryRevision {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salaryId           String    @map("salary_id") @db.Uuid
  previousAmount     Decimal?  @map("previous_amount") @db.Decimal(12, 2)
  previousCurrency   String?   @map("previous_currency") @db.Char(3)
  newAmount          Decimal   @map("new_amount") @db.Decimal(12, 2)
  newCurrency        String    @map("new_currency") @db.Char(3)
  effectiveDate      DateTime  @map("effective_date") @db.Date
  changedAt          DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedByUserId    String    @map("changed_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  salary    Salary @relation(fields: [salaryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  changedBy User   @relation(fields: [changedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([salaryId, changedAt(sort: Desc)], map: "salary_revisions_salary_id_changed_at_idx")
  @@index([salaryId, effectiveDate(sort: Desc)], map: "salary_revisions_salary_id_effective_date_idx")
  @@map("salary_revisions")
}

/// express-session PostgreSQL store shape (connect-pg-simple).
/// Association to User is logical via sess.userId — no DB foreign key.
model Session {
  sid    String   @id @db.Text
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamptz(6)

  @@index([expire], map: "session_expire_idx")
  @@map("session")
}
