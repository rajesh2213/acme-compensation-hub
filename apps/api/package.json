    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
